# Production Environment Configuration Example
# Copy to .env.production and fill in actual values

# GCP Configuration
GOOGLE_CLOUD_PROJECT=aipodcaster-481909
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account-key.json

# Application Settings
ENVIRONMENT=production
PORT=8080
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://crossfire.app,https://www.crossfire.app

# Feature Flags
ENABLE_QUALITY_EVALUATION=true
ENABLE_SAFETY_FILTERING=true
ENABLE_OBSERVABILITY=true

# Quality Thresholds
QUALITY_COHERENCE_THRESHOLD=0.85
QUALITY_SAFETY_THRESHOLD=0.90
QUALITY_TOXICITY_THRESHOLD=0.20

# Performance
MAX_CONCURRENT_DEBATES=10
DEBATE_TIMEOUT_SECONDS=300
