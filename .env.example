# ===================================
# CROSSFIRE PODCAST - Environment Variables
# ===================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# --- Google Cloud Platform ---
# Your GCP Project ID (find it in GCP Console)
GCP_PROJECT_ID=your-project-id-here

# Path to your GCP Service Account JSON key file
# Download from: GCP Console > IAM & Admin > Service Accounts > Keys
# IMPORTANT: Keep this file secure and NEVER commit it to git
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# --- GCS Bucket Configuration ---
# Name of your Google Cloud Storage bucket for audio files
# The bucket should already exist in your GCP project
GCS_BUCKET_NAME=your-bucket-name-here

# --- Server Configuration ---
# Backend API port (default: 8000)
BACKEND_PORT=8000

# Frontend port (default: 3000)
FRONTEND_PORT=3000

# --- Required IAM Roles ---
# Your service account needs these roles:
# - Vertex AI User (for Gemini API access)
# - Cloud Text-to-Speech User (for TTS synthesis)
# - Storage Object Admin (for GCS bucket access)

# --- Setup Instructions ---
# 1. Create a GCP project: https://console.cloud.google.com/
# 2. Enable these APIs:
#    - Vertex AI API
#    - Cloud Text-to-Speech API
#    - Cloud Storage API
# 3. Create a service account with the required roles
# 4. Download the service account key JSON
# 5. Create a GCS bucket for audio storage
# 6. Copy this file to .env and fill in your values
# 7. Run: chmod 600 .env (to protect your credentials)
